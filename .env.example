# Backend database connection
DB_HOST=8.148.187.51
DB_PORT=3306
DB_USER=usr
DB_PASSWORD=replace-with-your-database-password
DB_NAME=usr
DB_CONNECTION_LIMIT=10
PORT=15010
# Comma-separated frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:15011
VITE_API_BASE_URL=/api/v1

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# NOTE: the old MOONSHOT_API_KEY / MOONSHOT_BASE_URL / MOONSHOT_MODEL variables
# were removed. No code reads them any more; the AI assistant talks to DeepSeek.

# DeepSeek-compatible chat API (used by the warehouse AI assistant)
# Optional: the API still starts without it, but /ai/chat returns "not configured".
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Verified against GET /models: the valid IDs are `deepseek-flash` and
# `deepseek-v4-pro`. `deepseek-chat` is no longer offered and returns 400.
DEEPSEEK_MODEL=deepseek-flash
# MQTT transport for ESP32 devices. Set this to the broker reachable by the API.
# MQTT_URL must be configured for hardware telemetry and air-conditioner commands.
MQTT_URL=mqtt://8.148.187.51:1883
MQTT_USERNAME=user
MQTT_PASSWORD=root
MQTT_CLIENT_ID=initel-api
MQTT_UP_TOPIC=initel/devices/+/up
MQTT_DOWN_TOPIC=initel/devices/{roomId}/down
MQTT_DEVICE_TTL_MS=90000
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000
# Minimum interval between two PIR motion rows in operation_logs, per room.
# Repeated detections inside the interval are acknowledged but not stored.
# Set to 0 to store every reported detection.
MOTION_LOG_COOLDOWN_MS=30000
