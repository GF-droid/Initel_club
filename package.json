    "axios": "^1.7.4",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.0",
    "flv": "^0.0.1",
    "flv.js": "^1.6.2",
    "mitt": "^3.0.1",
    "openai": "^6.9.1",
    "particles.js": "^2.0.0",
    "pinia": "^2.2.2",
    "qrcode": "^1.5.4",
    "qrcode.vue": "^3.4.1",
    "vue": "^3.4.38",
    "vue-echarts": "^7.0.3",
